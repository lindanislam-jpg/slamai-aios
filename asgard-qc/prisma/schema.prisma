// ASGARD Quality Command Centre — data model.
//
// Conventions
// - Every business record carries `isDemo`. Seeded synthetic records set it to
//   true so the UI can label them DEMO DATA and so they can be purged in one go.
// - Human-readable references (PRJ-0001, INS-000001, NCR-0001 …) are issued
//   from the `Sequence` table inside the same transaction as the insert.
// - Nothing in here encodes an acceptance criterion. Criteria are free-text
//   references to approved documents, entered and approved by quality staff.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x = Netlify / AWS Lambda runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & security ─────────────────────────────

enum Role {
  ADMIN
  QUALITY_MANAGER
  QC_INSPECTOR
  WELDING_INSPECTOR
  MATERIAL_INSPECTOR
  PRODUCTION_VIEWER
  AUDITOR
  PRODUCTION_SUPERVISOR
  MAINTENANCE_TECHNICIAN
  PROJECT_MANAGER
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              Role      @default(PRODUCTION_VIEWER)
  active            Boolean   @default(true)
  /// Per-user notification preferences, e.g. { "muted": ["CALIBRATION_DUE"] }.
  notificationPrefs Json?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions      Session[]
  notifications Notification[]
}

/// Server-side sessions. Only the SHA-256 of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

/// Failed sign-in attempts, used to throttle password guessing.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// Append-only history of every change made through the application.
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String
  summary    String?
  before     Json?
  after      Json?

  @@index([entityType, entityId])
  @@index([at])
}

model Sequence {
  name  String @id
  value Int    @default(0)
}

/// Key/value configuration: release rules, required evidence, permission
/// overrides, notification thresholds, upload limits.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ───────────────────────────── Projects & units ─────────────────────────────

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  AWAITING_RELEASE
  RELEASED
  CLOSED
  CANCELLED
}

model Project {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  customerRef    String?
  description    String?
  scope          String?
  status         ProjectStatus @default(PLANNED)
  startDate      DateTime?
  targetDate     DateTime?
  projectManager String?
  departments    String?
  drawingRefs    String?
  /// Applicable inspection & test requirements (ITP reference, spec clauses).
  requirements   String?
  /// Ordered production stages for this project; null = organisation default.
  stages         String[]
  isDemo         Boolean       @default(false)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  units       Unit[]
  itpPlans    ItpPlan[]
  photos      Photo[]
  inspections Inspection[]
  welds       Weld[]
  materials   Material[]
  ndt         NdtRecord[]
  coatings    CoatingRecord[]
  ncrs        Ncr[]
  repairs     Repair[]
  documents   Document[]
  files       ProjectFile[]
  releases    ReleaseRecord[]
  reports     ReportJob[]
  cmrs        Cmr[]
  alerts      QualityAlert[]

  @@index([status])
}

enum UnitType {
  MODULE
  FRAME
  COMPONENT
}

/// A module, frame or component inside a project.
model Unit {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  ref         String
  type        UnitType @default(FRAME)
  parentId    String?
  parent      Unit?    @relation("UnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Unit[]   @relation("UnitTree")
  description String?
  drawingRef  String?
  revision    String?
  stage       String?
  released    Boolean  @default(false)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos      Photo[]
  files       ProjectFile[]
  inspections Inspection[]
  welds       Weld[]
  ncrs        Ncr[]
  ndt         NdtRecord[]
  coatings    CoatingRecord[]
  repairs     Repair[]
  releases    ReleaseRecord[]

  @@unique([projectId, ref])
}

// ───────────────────────────── Photo evidence ─────────────────────────────

enum ReviewStatus {
  PENDING_REVIEW
  REVIEWED
  APPROVED
  REJECTED
}

enum ReworkPhase {
  BEFORE
  AFTER
}

model Photo {
  id                String       @id @default(cuid())
  code              String       @unique
  projectId         String
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId            String?
  unit              Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  componentRef      String?
  stage             String?
  category          String
  inspectionType    String?
  /// Capture time from the image's own EXIF data. Null when the file has none —
  /// it is never back-filled with the upload time.
  takenAt           DateTime?
  uploadedAt        DateTime     @default(now())
  uploadedById      String?
  uploadedByName    String?
  responsiblePerson String?
  heatNumber        String?
  weldRef           String?
  inspectionId      String?
  inspection        Inspection?  @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  ncrId             String?
  ncr               Ncr?         @relation(fields: [ncrId], references: [id], onDelete: SetNull)
  weldId            String?
  weld              Weld?        @relation(fields: [weldId], references: [id], onDelete: SetNull)
  materialId        String?
  material          Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  repairId          String?
  repair            Repair?      @relation(fields: [repairId], references: [id], onDelete: SetNull)
  reworkPhase       ReworkPhase?
  caption           String?
  description       String?
  observedCondition String?
  correctiveAction  String?
  tags              String[]
  reviewStatus      ReviewStatus @default(PENDING_REVIEW)
  reviewedById      String?
  reviewedAt        DateTime?

  storageKey   String
  thumbKey     String?
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  sha256       String
  /// Draft output from the AI vision service. Never copied into the record
  /// without a person accepting it.
  aiSuggestion Json?
  isDemo       Boolean   @default(false)
  deletedAt    DateTime?

  @@index([projectId, category])
  @@index([unitId])
  @@index([sha256])
}

// ───────────────────────────── Inspections ─────────────────────────────

enum InspectionType {
  INCOMING_MATERIAL
  FABRICATION
  DIMENSIONAL
  WELD_VISUAL
  NDT
  COATING
  INTERMEDIATE
  FINAL
  OTHER
}

enum InspectionResult {
  PENDING
  PASS
  FAIL
  HOLD
  NA
}

enum RecordStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  ACCEPTED
  REJECTED
  CANCELLED
}

model Inspection {
  id               String           @id @default(cuid())
  code             String           @unique
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId           String?
  unit             Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  type             InspectionType
  /// Fabrication operation (cutting, drilling, bending …) for FABRICATION records.
  operation        String?
  stage            String?
  componentRef     String?
  drawingRef       String?
  plannedDate      DateTime?
  inspectedAt      DateTime?
  inspectorId      String?
  inspectorName    String?
  criteriaRef      String?
  result           InspectionResult @default(PENDING)
  status           RecordStatus     @default(DRAFT)
  comments         String?
  /// Set when this inspection re-checks an earlier failed/held one.
  reinspectionOfId String?
  reinspectionOf   Inspection?      @relation("Reinspection", fields: [reinspectionOfId], references: [id], onDelete: SetNull)
  reinspections    Inspection[]     @relation("Reinspection")
  reviewerId       String?
  reviewerName     String?
  reviewedAt       DateTime?
  isDemo           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items  ChecklistItem[]
  photos Photo[]
  ncrs   Ncr[]

  @@index([projectId, type])
  @@index([inspectedAt])
}

enum CriteriaStatus {
  DEFINED
  REQUIRES_CONFIGURATION
}

model ChecklistItem {
  id             String           @id @default(cuid())
  inspectionId   String
  inspection     Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  order          Int
  description    String
  /// Requirement text or reference to the approved document clause.
  requirement    String?
  criteriaStatus CriteriaStatus   @default(REQUIRES_CONFIGURATION)
  tolerance      String?
  actual         String?
  unit           String?
  result         InspectionResult @default(PENDING)
  notes          String?
  required       Boolean          @default(true)
}

/// Configurable checklist. Items are copied into an inspection when it is
/// created so later template edits never rewrite past records.
model ChecklistTemplate {
  id             String         @id @default(cuid())
  name           String
  inspectionType InspectionType
  /// [{ description, requirement?, tolerance?, unit?, required }]
  items          Json
  documentRef    String?
  approved       Boolean        @default(false)
  approvedById   String?
  approvedAt     DateTime?
  active         Boolean        @default(true)
  isDemo         Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// ───────────────────────────── Welding ─────────────────────────────

enum WeldStatus {
  AWAITING_INSPECTION
  ACCEPTED
  REPAIR_REQUIRED
  AWAITING_REINSPECTION
  REJECTED
}

model Weld {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId          String?
  unit            Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  weldRef         String
  componentRef    String?
  drawingRef      String?
  wpsRef          String?
  welderId        String?
  welderQualRef   String?
  process         String?
  materialDetails String?
  stage           String?
  inspectedAt     DateTime?
  inspectorName   String?
  visualResult    InspectionResult @default(PENDING)
  criteriaRef     String?
  ndtRequired     Boolean          @default(false)
  status          WeldStatus       @default(AWAITING_INSPECTION)
  notes           String?
  isDemo          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  defects WeldDefect[]
  photos  Photo[]
  ndt     NdtRecord[]
  ncrs    Ncr[]
  repairs Repair[]

  @@unique([projectId, weldRef])
}

enum DefectSource {
  INSPECTOR
  AI_SUGGESTION
}

model WeldDefect {
  id            String       @id @default(cuid())
  weldId        String
  weld          Weld         @relation(fields: [weldId], references: [id], onDelete: Cascade)
  category      String
  /// Only true once an authorised inspector confirms it.
  confirmed     Boolean      @default(false)
  confirmedById String?
  confirmedAt   DateTime?
  source        DefectSource @default(INSPECTOR)
  notes         String?
  recordedById  String?
  recordedAt    DateTime     @default(now())
  isDemo        Boolean      @default(false)
}

// ───────────────────────────── Materials ─────────────────────────────

enum CertStatus {
  MISSING
  UPLOADED_UNVERIFIED
  VERIFIED
  REJECTED
}

enum MaterialStatus {
  AWAITING_INSPECTION
  ACCEPTED
  REJECTED
  QUARANTINED
}

model Material {
  id                     String           @id @default(cuid())
  code                   String           @unique
  projectId              String?
  project                Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  componentRef           String?
  description            String
  grade                  String?
  supplier               String?
  poRef                  String?
  deliveryRef            String?
  heatNumber             String?
  certificateRef         String?
  certificateDocId       String?
  certStatus             CertStatus       @default(MISSING)
  quantity               Decimal?
  unit                   String?
  receivingResult        InspectionResult @default(PENDING)
  location               String?
  status                 MaterialStatus   @default(AWAITING_INSPECTION)
  identificationMismatch Boolean          @default(false)
  inspectorName          String?
  inspectedAt            DateTime?
  dispositionById        String?
  dispositionAt          DateTime?
  dispositionNotes       String?
  isDemo                 Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  photos Photo[]
  ncrs   Ncr[]

  @@index([heatNumber])
  @@index([grade])
}

// ───────────────────────────── NDT & coating ─────────────────────────────

enum TestResult {
  PENDING
  ACCEPT
  REJECT
}

model NdtRecord {
  id           String     @id @default(cuid())
  code         String     @unique
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId       String?
  unit         Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  weldId       String?
  weld         Weld?      @relation(fields: [weldId], references: [id], onDelete: SetNull)
  method       String
  procedureRef String?
  componentRef String?
  requestedAt  DateTime
  reportNo     String?
  reportDate   DateTime?
  contractor   String?
  personnelRef String?
  result       TestResult @default(PENDING)
  reportDocId  String?
  followUp     String?
  isDemo       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CoatingRecord {
  id            String           @id @default(cuid())
  code          String           @unique
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId        String?
  unit          Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  surfacePrep   String?
  product       String?
  batchRef      String?
  /// Free-text environmental readings as recorded (temp, RH, dew point).
  envReadings   String?
  /// Measured dry film thickness readings, as entered.
  dftReadings   String?
  specRef       String?
  result        InspectionResult @default(PENDING)
  inspectorName String?
  inspectedAt   DateTime?
  notes         String?
  isDemo        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ───────────────────────────── NCR / CAPA / rework ─────────────────────────────

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Matches the severity used on the company NCR form (QC-NCR-001).
enum NcrSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum ImpactLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum EffectivenessStatus {
  PENDING
  EFFECTIVE
  NOT_EFFECTIVE
}

enum NcrStatus {
  OPEN
  CONTAINED
  INVESTIGATING
  ACTION_IN_PROGRESS
  AWAITING_VERIFICATION
  CLOSED
  CANCELLED
}

model Ncr {
  id                  String               @id @default(cuid())
  code                String               @unique
  projectId           String
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId              String?
  unit                Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  componentRef        String?
  raisedAt            DateTime             @default(now())
  raisedById          String?
  raisedByName        String?
  description         String
  defectCategory      String
  requirementRef      String?
  containment         String?
  priority            Priority             @default(MEDIUM)
  severity            NcrSeverity?
  department          String?
  stageOfDetection    String?
  detectedBy          String?
  drawingRef          String?
  contributingFactors String?
  impactStructural    ImpactLevel?
  impactSafety        ImpactLevel?
  impactSchedule      ImpactLevel?
  impactCustomer      ImpactLevel?
  impactCost          ImpactLevel?
  impactQms           ImpactLevel?
  impactNotes         String?
  /// Verification of effectiveness after closure (company form section 7).
  effectivenessDueAt  DateTime?
  effectivenessStatus EffectivenessStatus?
  effectivenessNotes  String?
  effectivenessById   String?
  effectivenessByName String?
  effectivenessAt     DateTime?
  rootCauseCategory   String?
  rootCauseMethod     String?
  rootCause           String?
  disposition         String?
  repairMethod        String?
  ownerName           String?
  targetDate          DateTime?
  status              NcrStatus            @default(OPEN)
  verificationNotes   String?
  reinspectionResult  InspectionResult?
  verifiedById        String?
  verifiedAt          DateTime?
  closedById          String?
  closedByName        String?
  closedAt            DateTime?
  inspectionId        String?
  inspection          Inspection?          @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  weldId              String?
  weld                Weld?                @relation(fields: [weldId], references: [id], onDelete: SetNull)
  materialId          String?
  material            Material?            @relation(fields: [materialId], references: [id], onDelete: SetNull)
  relatedCodes        String[]
  isDemo              Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  actions CorrectiveAction[]
  photos  Photo[]
  repairs Repair[]

  @@index([projectId, status])
  @@index([defectCategory])
}

enum ActionType {
  CORRECTIVE
  PREVENTIVE
  CONTAINMENT
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

model CorrectiveAction {
  id             String        @id @default(cuid())
  code           String        @unique
  ncrId          String?
  ncr            Ncr?          @relation(fields: [ncrId], references: [id], onDelete: Cascade)
  auditFindingId String?
  auditFinding   AuditFinding? @relation(fields: [auditFindingId], references: [id], onDelete: Cascade)
  type           ActionType    @default(CORRECTIVE)
  description    String
  ownerName      String?
  dueDate        DateTime?
  status         ActionStatus  @default(OPEN)
  completedAt    DateTime?
  verifiedById   String?
  verifiedAt     DateTime?
  notes          String?
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Repair {
  id                 String           @id @default(cuid())
  code               String           @unique
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId             String?
  unit               Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  ncrId              String?
  ncr                Ncr?             @relation(fields: [ncrId], references: [id], onDelete: SetNull)
  weldId             String?
  weld               Weld?            @relation(fields: [weldId], references: [id], onDelete: SetNull)
  description        String
  method             String?
  performedBy        String?
  performedAt        DateTime?
  /// Actual hours/cost only when supplied. `costIsEstimate` marks estimates.
  hours              Decimal?
  cost               Decimal?
  costIsEstimate     Boolean          @default(false)
  reinspectionResult InspectionResult @default(PENDING)
  reinspectedBy      String?
  reinspectedAt      DateTime?
  notes              String?
  isDemo             Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  photos Photo[]
}

// ───────────────────────────── Audits ─────────────────────────────

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

model QualityAudit {
  id           String      @id @default(cuid())
  code         String      @unique
  title        String
  auditType    String
  scope        String?
  /// References the organisation's own procedures/standards — never a claim
  /// of compliance.
  standardRefs String?
  scheduledAt  DateTime
  auditor      String?
  status       AuditStatus @default(PLANNED)
  checklist    Json?
  summary      String?
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  findings AuditFinding[]
}

enum FindingType {
  NONCONFORMITY
  OBSERVATION
  OPPORTUNITY
}

enum FindingStatus {
  OPEN
  ACTION_IN_PROGRESS
  AWAITING_VERIFICATION
  CLOSED
}

model AuditFinding {
  id           String        @id @default(cuid())
  code         String        @unique
  auditId      String
  audit        QualityAudit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  type         FindingType
  description  String
  clauseRef    String?
  evidence     String?
  ownerName    String?
  dueDate      DateTime?
  status       FindingStatus @default(OPEN)
  closedAt     DateTime?
  verifiedById String?
  isDemo       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  actions CorrectiveAction[]
}

// ───────────────────────────── Documents & calibration ─────────────────────────────

enum DocStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  SUPERSEDED
  OBSOLETE
}

model Document {
  id        String    @id @default(cuid())
  docNo     String    @unique
  title     String
  docType   String
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ownerName String?
  status    DocStatus @default(DRAFT)
  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  revisions DocumentRevision[]
}

/// Revisions are append-only: an approved revision is never overwritten, a
/// change is always a new revision.
model DocumentRevision {
  id             String    @id @default(cuid())
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision       String
  storageKey     String?
  fileName       String?
  mimeType       String?
  sizeBytes      Int?
  sha256         String?
  notes          String?
  status         DocStatus @default(UNDER_REVIEW)
  uploadedById   String?
  uploadedByName String?
  uploadedAt     DateTime  @default(now())
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  @@unique([documentId, revision])
}

enum EquipmentStatus {
  IN_SERVICE
  RESTRICTED
  OUT_OF_SERVICE
  RETIRED
}

model Equipment {
  id            String          @id @default(cuid())
  assetNo       String          @unique
  description   String
  equipmentType String?
  ownerName     String?
  serialNo      String?
  location      String?
  /// Calibration interval. Null when the asset does not need calibration.
  intervalDays  Int?
  status        EquipmentStatus @default(IN_SERVICE)
  statusNote    String?
  active        Boolean         @default(true)
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  calibrations CalibrationRecord[]
  cmrs         Cmr[]
}

// ───────────────────── Corrective Maintenance Requests ─────────────────────

enum CmrStatus {
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  AWAITING_PARTS
  AWAITING_EXTERNAL
  AWAITING_VERIFICATION
  COMPLETED
  CLOSED
  CANCELLED
}

model Cmr {
  id                   String     @id @default(cuid())
  code                 String     @unique
  equipmentId          String?
  equipment            Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  /// Free-text asset name when the equipment is not in the register.
  assetLabel           String?
  location             String?
  projectId            String?
  project              Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  productionArea       String?
  problem              String
  reportedAt           DateTime   @default(now())
  reportedById         String?
  reportedByName       String?
  priority             Priority   @default(MEDIUM)
  safetyImpact         Boolean    @default(false)
  productionImpact     String?
  equipmentUnavailable Boolean    @default(false)
  requestedBy          DateTime?
  status               CmrStatus  @default(SUBMITTED)
  acknowledgedAt       DateTime?
  acknowledgedByName   String?
  assignedToName       String?
  assignedAt           DateTime?
  diagnosis            String?
  workDone             String?
  partsUsed            String?
  startedAt            DateTime?
  completedAt          DateTime?
  downtimeHours        Decimal?
  outstandingIssues    String?
  /// Return-to-service verification by an authorised person (not the system).
  verifiedById         String?
  verifiedByName       String?
  verifiedAt           DateTime?
  verificationNote     String?
  closedAt             DateTime?
  cancelReason         String?
  reopenCount          Int        @default(0)
  /// Earlier closures kept when a CMR is reopened (append-only).
  closureHistory       Json?
  isDemo               Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  attachments CmrAttachment[]

  @@index([status])
  @@index([equipmentId, reportedAt])
}

model CmrAttachment {
  id             String   @id @default(cuid())
  cmrId          String
  cmr            Cmr      @relation(fields: [cmrId], references: [id], onDelete: Restrict)
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String   @unique
  caption        String?
  uploadedById   String?
  uploadedByName String?
  uploadedAt     DateTime @default(now())
}

// ───────────────────────────── Smart Quality Alerts ─────────────────────────────

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

/// Configurable rule. Evaluation logic is deterministic code keyed by `key`;
/// this row holds what an administrator may change. Every change bumps
/// `version` and is written to the audit trail.
model AlertRule {
  id            String        @id @default(cuid())
  key           String        @unique
  name          String
  description   String
  category      String
  severity      AlertSeverity
  enabled       Boolean       @default(true)
  params        Json?
  version       Int           @default(1)
  updatedByName String?
  updatedAt     DateTime      @updatedAt
  createdAt     DateTime      @default(now())
}

model QualityAlert {
  id                 String        @id @default(cuid())
  code               String        @unique
  ruleKey            String
  ruleVersion        Int
  /// One alert per rule per affected record.
  dedupeKey          String        @unique
  category           String
  severity           AlertSeverity
  title              String
  detail             String?
  /// The records that triggered the alert, as evaluated.
  evidence           Json?
  href               String?
  projectId          String?
  project            Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status             AlertStatus   @default(NEW)
  assignedToName     String?
  acknowledgedByName String?
  acknowledgedAt     DateTime?
  resolvedByName     String?
  resolvedAt         DateTime?
  resolutionNote     String?
  dismissedReason    String?
  firstRaisedAt      DateTime      @default(now())
  lastSeenAt         DateTime      @default(now())
  /// Set while the triggering condition is no longer present.
  conditionClearedAt DateTime?
  reopenCount        Int           @default(0)
  updatedAt          DateTime      @updatedAt

  @@index([status, severity])
  @@index([projectId])
}

model CalibrationRecord {
  id             String    @id @default(cuid())
  equipmentId    String
  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  calibratedAt   DateTime
  dueAt          DateTime
  certificateRef String?
  provider       String?
  result         String?
  documentId     String?
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

// ───────────────────────────── Release ─────────────────────────────

enum ReleaseStatus {
  RELEASED
  RELEASED_WITH_CONCESSION
  REVOKED
}

model ReleaseRecord {
  id               String        @id @default(cuid())
  code             String        @unique
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId           String?
  unit             Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  status           ReleaseStatus
  /// The evaluated checklist at the moment of release.
  checks           Json
  concessionRef    String?
  concessionReason String?
  releasedById     String
  releasedByName   String
  releasedAt       DateTime      @default(now())
  notes            String?
  revokedById      String?
  revokedAt        DateTime?
  revokeReason     String?
  isDemo           Boolean       @default(false)
}

// ───────────────────────────── Notifications & reports ─────────────────────────────

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  severity   String    @default("info")
  title      String
  body       String?
  href       String?
  /// One notification per user per condition (e.g. "NCR_OVERDUE:ncrId").
  dedupeKey  String
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  resolvedAt DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model ReportJob {
  id            String    @id @default(cuid())
  code          String    @unique
  reportType    String
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  params        Json
  revision      Int       @default(1)
  status        String    @default("PENDING")
  storageKey    String?
  sizeBytes     Int?
  error         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

// ───────────────────────────── Inspection & Test Plan ─────────────────────────────

/// H = hold, W = witness, I = inspect, R = review, M = monitor, S = surveillance,
/// A = accept — as defined on the company ITP (QF 6.14).
enum ControlPointType {
  H
  W
  I
  R
  M
  S
  A
}

enum ControlPointStatus {
  OPEN
  SIGNED
  NOT_APPLICABLE
}

/// An ITP applied to one project (one discipline, e.g. Structural).
model ItpPlan {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  discipline  String
  documentRef String?
  sourceFile  String?
  isDemo      Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  points ControlPoint[]

  @@unique([projectId, discipline])
}

model ControlPoint {
  id                 String             @id @default(cuid())
  planId             String
  plan               ItpPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  order              Int
  itemNo             String
  section            String?
  activity           String
  acceptanceCriteria String?
  method             String?
  frequency          String?
  extent             String?
  responsibility     String?
  signoffDocument    String?
  verifyingDocument  String?
  /// Control point for the manufacturer (AMM column). Client / third-party
  /// points are kept as recorded on the ITP.
  pointType          ControlPointType?
  subPoint           String?
  clientPoint        String?
  thirdPartyPoint    String?
  status             ControlPointStatus @default(OPEN)
  signedById         String?
  signedByName       String?
  signedAt           DateTime?
  evidence           String?
  isDemo             Boolean            @default(false)

  @@index([planId, status])
}

/// Any file kept against a project (drawings, purchase orders, certificates,
/// client correspondence, QC packs). Not a controlled document: no approval
/// workflow. Removal is a recorded withdrawal; the stored bytes are kept.
model ProjectFile {
  id             String    @id @default(cuid())
  code           String    @unique
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unitId         String?
  unit           Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category       String
  notes          String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String    @unique
  uploadedAt     DateTime  @default(now())
  uploadedById   String?
  uploadedByName String?
  removedAt      DateTime?
  removedByName  String?
  removeReason   String?
  isDemo         Boolean   @default(false)

  @@index([projectId, removedAt])
  @@index([sha256])
}

// ───────────────────────── Scheduled system & quality review ─────────────────────────

enum SystemRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  MISSED
}

/// One scheduled (09:00 / 12:00 / 18:00 Europe/Dublin) or manual review.
/// `runKey` is unique so a slot can never run twice; a retry gets its own key.
model SystemCheckRun {
  id            String          @id @default(cuid())
  code          String          @unique
  runKey        String          @unique
  kind          String
  slotDate      String?
  slotTime      String?
  scheduledFor  DateTime?
  status        SystemRunStatus @default(RUNNING)
  /// Technical health only (HEALTHY / WARNING / CRITICAL / FAILED).
  health        String?
  /// Manufacturing quality attention level, kept separate from technical health.
  qualityStatus String?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  triggeredBy   String
  retryOfId     String?
  passed        Int             @default(0)
  warnings      Int             @default(0)
  failed        Int             @default(0)
  notRun        Int             @default(0)
  checks        Json?
  summary       Json?
  changes       Json?
  actions       Json?
  notifications Json?
  error         String?

  @@index([startedAt])
  @@index([status])
}
