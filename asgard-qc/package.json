{
  "name": "asgard-qc",
  "version": "1.0.0",
  "private": true,
  "description": "ASGARD Modular Manufacturing — Quality Command Centre",
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "prisma generate && next build",
    "start": "next start --port 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:studio": "prisma studio",
    "notifications:run": "tsx --conditions=react-server scripts/run-notifications.ts",
    "backup": "bash scripts/backup.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:purge-demo": "tsx --conditions=react-server scripts/purge-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "lucide-react": "^1.62.0",
    "next": "^15.5.28",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
