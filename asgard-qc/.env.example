# ASGARD Quality Command Centre — environment variables.
# Copy to .env (never commit .env). Server-only: none of these are exposed to the browser.

# ── Database (PostgreSQL 14+) ──
DATABASE_URL="postgresql://asgard:CHANGE_ME@localhost:5432/asgard_qc"

# ── File storage for photos, document revisions and generated reports ──
# local = files on this server's disk (outside the web root); s3 = S3-compatible bucket.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="eu-west-2"
# S3_ENDPOINT=""            # e.g. MinIO/Wasabi endpoint; leave empty for AWS
# S3_FORCE_PATH_STYLE="false"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Optional AI-assisted photo review (draft captions / possible observations only) ──
# Leave ANTHROPIC_API_KEY empty to disable; everything else keeps working.
ANTHROPIC_API_KEY=""
# AI_VISION_MODEL="claude-opus-5-5"
# AI_VISION_ENABLED="true"

# ── Optional external QMS integration (no adapter is installed yet — see docs/INTEGRATIONS.md) ──
# QMS_PROVIDER=""

# ── Cookies: only set to "true" when running production builds over plain HTTP on a closed LAN ──
# INSECURE_COOKIES="false"

# ── Seeding (npm run db:seed) — read only by the seed script ──
ADMIN_EMAIL=""
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""            # min 10 characters
SEED_DEMO_DATA="false"        # "true" adds clearly labelled synthetic DEMO records
DEMO_USER_PASSWORD=""         # only used when SEED_DEMO_DATA=true; creates example.com demo role accounts

# ── Tests (npm test) — must point at a throwaway database whose name contains "test" ──
# TEST_DATABASE_URL="postgresql://asgard:CHANGE_ME@localhost:5432/asgard_qc_test"
