# Capital.com API credentials (DEMO account). Create a key in the platform:
#   Settings > API integrations > Generate API key
# The "password" below is the API-key password you set when generating the key,
# NOT your account login password.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=you@example.com
CAPITAL_PASSWORD=

# Guard: the runner refuses the LIVE endpoint unless this is 1 (leave unset).
# CAPITAL_ALLOW_LIVE=0
