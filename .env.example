# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ---- Database (Postgres) ----
DATABASE_URL="postgresql://user:password@host:5432/slamai"
DIRECT_URL="postgresql://user:password@host:5432/slamai"

# ---- Auth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The public URL of the site. http://localhost:3005 in development.
NEXTAUTH_URL="http://localhost:3005"

# ---- OpenAI ----
OPENAI_API_KEY=""

# ---- Stripe ----
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=""
# Price IDs from the Stripe dashboard (one per paid plan).
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_ENTERPRISE=""

# ---- Public site details (shown on the landing page) ----
# NEXT_PUBLIC_ vars are visible in the browser — never put secrets here.
# Anything left empty is hidden on the page rather than shown as a placeholder,
# so the site never displays a number nobody answers.
NEXT_PUBLIC_DEMO_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_BOOKING_URL=""

# ---- Twilio (Voice AI) ----
TWILIO_ACCOUNT_SID=""
# Signs every inbound webhook. Without it, calls are rejected.
TWILIO_AUTH_TOKEN=""
# Only set if the public URL differs from NEXTAUTH_URL (e.g. an ngrok tunnel).
# The Twilio signature is computed over the exact URL Twilio called.
TWILIO_WEBHOOK_BASE_URL=""
# Local testing against a tunnel only — never set this in production.
# TWILIO_SKIP_VALIDATION="true"

# ---- Seeding the admin account (npm run db:seed) ----
# Not read at runtime — only by the seed script.
ADMIN_EMAIL=""
ADMIN_NAME="Admin"
ADMIN_PASSWORD=""
# Set to "false" to skip the demo contacts/agents/project.
SEED_DEMO_DATA="true"

# ===========================================================================
# MONEY TRANSFER MODULE
# ---------------------------------------------------------------------------
# Nothing here is secret unless marked. NEXT_PUBLIC_ vars are visible in the
# browser — never put a credential in one.
# ===========================================================================

# ---- Brand (the company name is not hardcoded anywhere) ----
NEXT_PUBLIC_REMIT_BRAND_NAME="Kora"
NEXT_PUBLIC_REMIT_BRAND_SUFFIX="Send"
NEXT_PUBLIC_REMIT_TAGLINE="Send money. Know the cost. Know what they get."
NEXT_PUBLIC_REMIT_SUPPORT_EMAIL=""
# Prefix on customer-facing transfer references, e.g. KS-7QK4-2M9X.
NEXT_PUBLIC_REMIT_REFERENCE_PREFIX="KS"
# Shown on legal pages. Leave as a placeholder until a real entity exists.
NEXT_PUBLIC_REMIT_LEGAL_ENTITY=""

# ---- Demo mode ----
# Enables the sandbox simulator that walks a demo transfer through the real
# state machine. MUST be "false" in production.
REMIT_DEMO_MODE="true"

# ---- Quotes ----
# How long a quoted price is honoured before the customer must request a new one.
REMIT_QUOTE_TTL_SECONDS="900"

# ---- Provider selection ----
# "sandbox" implementations are always available and move no money.
# Swap one of these for a real provider key once credentials exist.
REMIT_PAYMENT_PROVIDER="sandbox"       # "sandbox" | "stripe"
REMIT_PAYOUT_PROVIDER="sandbox"
REMIT_FX_PROVIDER="sandbox"
REMIT_KYC_PROVIDER="sandbox"
REMIT_SCREENING_PROVIDER="sandbox"
REMIT_NOTIFICATION_PROVIDER="sandbox"

# ---- Compliance thresholds (minor units, i.e. cents) ----
# Transfers at or above this are held for a human compliance decision.
REMIT_REVIEW_THRESHOLD_MINOR="100000"
# Transfers at or above this require completed KYC. 0 = always required.
REMIT_KYC_THRESHOLD_MINOR="0"
# Transfers in 24h that trip the velocity rule.
REMIT_VELOCITY_COUNT_PER_DAY="5"

# ---- Rate limits (requests per window, per identity) ----
REMIT_RATE_LIMIT_QUOTE="30"
REMIT_RATE_LIMIT_TRANSFER="10"
REMIT_RATE_LIMIT_AUTH="10"

# ---- Webhook signing (SECRET) ----
# HMAC-SHA256 secret for payout webhooks. Without it every webhook is
# rejected — verification fails closed by design.
REMIT_PAYOUT_WEBHOOK_SECRET=""

# ---- Seeding (npm run db:seed:remit). Not read at runtime. ----
REMIT_ADMIN_EMAIL=""
REMIT_ADMIN_PASSWORD=""
REMIT_DEMO_EMAIL=""
REMIT_DEMO_PASSWORD=""
