# Copy to .env.local and fill in. Never commit real values.

# --- Database (required) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/slamai?sslmode=require"
# Direct (non-pooled) connection, used by prisma migrate / db push.
DIRECT_URL="postgresql://user:password@host:5432/slamai?sslmode=require"

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public origin of the deployment, e.g. https://slamai-trading.vercel.app
NEXTAUTH_URL="http://localhost:3005"

# --- OpenAI (optional) ---
# Without this the app still builds and runs; the agent chat, marketing
# generator and document analyser return 503 instead of failing at startup.
OPENAI_API_KEY=""

# --- Stripe (optional, billing) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Seeding (only needed when running `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@slamai.local"
SEED_ADMIN_NAME="SlamAI Admin"
SEED_ADMIN_PASSWORD=""
