# Postgres connection used by Prisma. DIRECT_URL is the non-pooled URL used for
# migrations (Supabase/Neon style); point it at the same database.
DATABASE_URL="postgresql://user:password@host:5432/slamai"
DIRECT_URL="postgresql://user:password@host:5432/slamai"

# Auth.js signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Password for the seeded admin account (prisma/seed.ts). Required to run db:seed.
SEED_ADMIN_PASSWORD=""

OPENAI_API_KEY=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
