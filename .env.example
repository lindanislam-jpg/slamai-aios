# ============================================================================
# SlamAI — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to .env.local (and .env, which Prisma reads) and fill in real
# values. Both are gitignored. NEVER commit real secrets.
#
# Anything prefixed NEXT_PUBLIC_ is visible in the browser. Never put a secret
# behind that prefix.
#
# What is genuinely required to run:      DATABASE_URL, NEXTAUTH_SECRET
# What is required for the AI to answer:  AI_API_KEY
# What is required for real phone calls:  VOICE_PROVIDER_* and a public URL
# What is required to take money:         STRIPE_*
#
# Everything else degrades gracefully and the dashboard tells you what is
# missing rather than pretending a feature works.
# ============================================================================

# ---- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/slamai"
# Direct (non-pooled) connection, used for migrations. On Neon/Supabase this
# differs from DATABASE_URL; elsewhere set it to the same value.
DIRECT_URL="postgresql://user:password@host:5432/slamai"

# ---- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The public URL of the deployment. http://localhost:3005 in development.
NEXTAUTH_URL="http://localhost:3005"

# The canonical public URL. Used in webhook callbacks and notification links.
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Optional: Google sign-in. Leave blank to use email and password only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- AI provider -----------------------------------------------------------
# Which adapter to use. Currently: openai
AI_PROVIDER="openai"
AI_API_KEY=""
# Optional overrides.
AI_CHAT_MODEL="gpt-4o"
AI_EMBEDDING_MODEL="text-embedding-3-small"
# Point at an OpenAI-compatible gateway if you use one.
AI_BASE_URL=""

# Legacy name, still read as a fallback so the existing AIOS app keeps working.
OPENAI_API_KEY=""

# ---- Voice provider (telephony) --------------------------------------------
# Which adapter to use. Currently: twilio
VOICE_PROVIDER="twilio"
VOICE_PROVIDER_ACCOUNT_ID=""
# Signs every inbound call webhook. Without it, webhooks are rejected.
VOICE_PROVIDER_API_KEY=""
# Set only when the public URL differs from NEXT_PUBLIC_APP_URL, e.g. an ngrok
# tunnel. The webhook signature is computed over the exact URL called.
VOICE_WEBHOOK_BASE_URL=""
# Development only, against a tunnel. Ignored when NODE_ENV=production.
# VOICE_SKIP_SIGNATURE_CHECK="true"

# ---- Stripe (billing) ------------------------------------------------------
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=""

# Price IDs, created in Stripe. A plan with no price ID cannot be bought and
# the billing page says so rather than opening a checkout that would fail.
STRIPE_PRICE_VOICE_STARTER=""
STRIPE_PRICE_VOICE_BUSINESS=""
STRIPE_PRICE_VOICE_PRO=""
STRIPE_PRICE_VOICE_ENTERPRISE=""

# ---- Notifications ---------------------------------------------------------
# Email delivery. Without this, email rules are recorded as "skipped" rather
# than reported as sent.
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM="SlamAI Voice <notifications@yourdomain.com>"

# SMS delivery uses the voice provider's credentials plus a sending number.
NOTIFICATION_SMS_FROM=""

# ---- Outbound webhooks (n8n, Zapier, CRMs) ---------------------------------
# Each endpoint gets its own signing secret, generated when it is created in
# the dashboard. This is only a shared fallback for fixed internal receivers.
N8N_WEBHOOK_SECRET=""

# ---- Public site details ---------------------------------------------------
# Visible in the browser. Anything left empty is hidden on the page rather than
# shown as a placeholder, so the site never displays a number nobody answers.
NEXT_PUBLIC_DEMO_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_BOOKING_URL=""

# ---- Seeding ---------------------------------------------------------------
# Read only by the seed scripts, never at runtime.
ADMIN_EMAIL=""
ADMIN_NAME="Admin"
ADMIN_PASSWORD=""
SEED_DEMO_DATA="true"

# The sales-demo workspace created by `npm run db:seed:voice`.
DEMO_EMAIL="demo@slamai.io"
DEMO_PASSWORD=""

# ---- Legacy AIOS plan prices (the original app, still in this repo) ---------
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_ENTERPRISE=""

# ---- Legacy Twilio names (still read as a fallback) -------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_BASE_URL=""
